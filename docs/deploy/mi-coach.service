[Unit]
Description=Powerbuilding Coach (mi-coach) — Express API + SPA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajustar si clonás el repo en otra ruta:
WorkingDirectory=/opt/mi-coach
# coach.db persistente fuera del repo (sobrevive a git pull y entra en backups del CT):
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=COACH_DB_PATH=/var/lib/mi-coach/coach.db
# Zona horaria del atleta: la fecha/hora del día entrenado se setea con date('now','localtime').
# Si el host está en UTC y esto falta, la hora queda corrida y una sesión nocturna cae en
# la fecha del día siguiente. Ajustar a tu zona:
Environment=TZ=America/Argentina/Buenos_Aires
# Password de un solo usuario (se hashea con bcrypt al primer boot).
# Ver docs/deploy/TAILSCALE.md para resetearlo.
Environment=AUTH_PASSWORD=changeme
ExecStart=/usr/bin/node server/dist/index.js
Restart=always
RestartSec=3
User=micoach
Group=micoach

[Install]
WantedBy=multi-user.target
